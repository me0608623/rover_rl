# ============================================================================
# VO 安全層參數（夾在 RL policy 與底盤 mux 之間，只管「移動中的動態障礙」）
# ----------------------------------------------------------------------------
# 目標行為（依人相對車的橫向位置自動分流，由 DWA rollout 可行性天生產生，非寫死）：
#   ① 人完全正對、佔住車正前方（橫向偏移 < 通道半寬 ≈ r_robot+r_obs+margin ≈ 0.95m）
#        → 左右緩弧都會撞 → 只剩停/猛轉 → 減速「停止」
#   ② 人走過來但偏一側（例如偏左、右邊有縫）
#        → 只有右側弧線 rollout 不撞 → 往「有縫那側繞行」通過
#   ③ 人站著不動（收斂後 vel≈0）
#        → 當「靜態位置」避：正對近距→停(=①)、偏側有空間→放行(=②)。VO 不 drop 任何障礙。
#
# ⚠ 不做「speed 門檻 drop」：曾加 min_obstacle_speed 把慢障礙整顆丟給 RL，但會漏看近前
#    小碎步的人 + KF 收斂期的快速闖入者(速度暫讀≈0)→ 已收回。年輕 track 的保守處理改走
#    min_vel_confidence「速度歸零當靜態」（不漏看、不亂煞），見該參數。
#
# 調校旋鈕對照（要改行為先看這張表，數字意義詳見各參數行）：
#   「該停 vs 該繞」的分界    → w_w（轉彎成本，大→偏停）、horizon（大→偏停）
#   「繞哪一側」             → 可行性為主；w_goal 只在兩側皆可行時當選邊提示
#   「年輕 track 信不信速度」  → min_vel_confidence（低於門檻當靜態位置避，不外推、不 drop）
#   「多近才介入」           → engage_range
#   「障礙膨脹/安全餘裕」      → margin（大→愛停，小→敢繞）
#   輸出上限/平滑           → v_max/w_max（硬上限）、accel_v/accel_w（slew）
#
# ⚠ 下列數值為「正對停/偏側繞」的數學推估起點，需開 lv-dot 用真人走三情境實測微調。
# ⚠ 改任何值前先 cp 一份備份；w_goal 必須 < w_v。
# ============================================================================
vo_safety_node:
  ros__parameters:
    # --- Topics / service ---
    # policy_node 改發到 cmd_vel_desired，VO 處理後才送進 mux 的 /input/nav_cmd_vel
    topic_cmd_in: "/rover_rl/cmd_vel_desired"   # RL 原始期望 cmd（VO 輸入）
    topic_cmd_out: "/input/nav_cmd_vel"         # VO 處理後送 mux 的 cmd
    topic_odom: "/odom"                          # 當前速度/朝向來源
    topic_obstacles: "/vo_interface/tracked_obstacles"   # vo_interface KF 平滑追蹤（持久ID+平滑速度）
    topic_goal_status: "/rover_rl_policy/status"   # policy status JSON → 取 goal_dist/goal_ang_deg 當 VO goal 導向

    # --- 看門狗（fail-safe）：盯每路輸入有沒有按時來，逾時就進安全行為 ---
    # 逾時門檻 ≈ 正常週期的 2~3 倍，偶爾掉一兩幀不會誤判。
    timeout_desired_s: 0.5      # RL 期望 cmd 斷線(>0.5s 沒新指令) → 發 0 停車（命脈，不能用舊指令亂跑）
    timeout_odom_s: 0.3         # odom 斷線(>0.3s) → 發 0 停車（連自己車速都不知，碰撞預測算不了）
    timeout_obstacles_s: 1.0    # 動態障礙源斷線(>1.0s) → 放行不停車（只是加分避障；靜態仍由 RL 的 LiDAR sweep 擋）
    timeout_goal_s: 1.5         # goal(policy status) 斷線(>1.5s) → 視為無 goal，goal 導向項自動關（退回純貼近 RL）

    # --- 障礙速度信心門檻（年輕 track 的保守處理；不 drop、只決定信不信它的速度）---
    # vo_interface 每個 track 附 vel_confidence(0~1)，KF 約 0.5s 收斂到滿。低於此門檻 →
    # 把該 track「當靜態位置」避（速度歸零、不外推），但**仍進 VO 會減速/停**。
    # ⚠ 為何是「歸零」不是「drop」：drop=整顆漏看=安全洞（近前小碎步、KF 收斂期的快速闖入者
    #    都會被誤丟）。歸零=不漏看(位置照避)+不亂煞(不信跳動速度)，是正確的保守處理。
    # 0.3：濾掉剛冒出、速度未收斂的年輕 track 假速度；站著不動的人(收斂後 vel≈0、conf高)
    #    本就只當靜態位置避，正對近距會停(=正對停需求)、偏側有空間會放行(=偏側繞需求)。
    min_vel_confidence: 0.3

    # --- 頻率 ---
    ctrl_rate_hz: 20.0          # 控制輸出（= dynamic window 可達時間 ctrl_dt 來源）

    # --- 輸出硬上限（對齊底盤真實能力）---
    v_max: 1.0                  # 線速度輸出上限(m/s)
    v_min: -0.2                 # 線速度輸出下限(m/s，允許倒退)
    w_max: 1.2                  # ★底盤真實上限；順便壓掉 RL 可能叫出的 2.0（sim-to-real gap #2）
    accel_v: 1.2               # 對齊底盤 acc_max（候選窗 + 輸出 slew 共用）
    accel_w: 3.0               # 角加速度上限(rad/s²)
    window_time: 1.0           # 候選視窗可達時間(s)，與控制週期解耦讓 VO 能選繞行解；
                               # 太小→只會減速/停車，太大→候選過於樂觀。1.0 為起點

    # --- 取樣解析度（候選數 = n_v × n_w，越大越精細但越吃 CPU）---
    n_v: 7                     # 線速度取樣數
    n_w: 15                    # 角速度取樣數

    # --- 軌跡 rollout（碰撞預測）---
    # ⚠ horizon 是「VO 太保守」的最大旋鈕：rollout 假設機器人用同一組 (v,ω) 凍結直開
    # horizon 秒，無法表達 RL 的動態繞行（先轉再拉直）→ horizon 太長會把 RL 可繞的候選
    # 誤判成會撞、只剩停車。實測 3.0 過保守（RL 想轉繞卻被壓停），1.2 讓 RL 動態繞行有空間。
    horizon: 1.0               # s，往前預測多久。1.2→1.0（保守調：縮短預測讓側弧較不易被判會撞→
                               # RL 轉向繞行較易放行）。平衡值：太短(0.8)→正面對衝也能猛轉鑽過(該停沒停)；
                               # 太長(2~3)→偏一側的繞行弧線也被判會撞變成全停。
    sim_dt: 0.1                # s，rollout 步長

    # --- 安全幾何 ---
    r_robot: 0.35              # 與訓練/底盤一致
    margin: 0.15            # ★= rollout 保證的最小通過間距（中心距≥r_robot+r_obs+margin→邊緣間距≥margin）。
                              # 0.2→0.15（保守調：縮小膨脹讓側邊縫隙較易判可行→敢繞一點，仍留 15cm 邊緣間距）。
                              # 0.10→0.30→0.40（要繞更開一點改）：0.10 只距人 10cm 就判「可繞」→貼身繞嚇人；
                              # 0.40=至少距人 40cm 才繞，且 escape 會退更多才退出(要 40cm 間距孤線可行才繞)。
                              # 太大→近處愛停(但有 escape 兜底)；嫌太閃可降到 0.20。靜態牆歸 RL，這只影響繞動態人的間距。
    obstacle_radius_max: 0.6  # ★bbox 換算半徑上限。1.5→0.6（實車抓到主因）：LV-DOT 偶發吐
                              # 半徑 2m+ 的假巨框（如 id 11209 r=2.13 conf=0.07），1.5 封頂後撞半徑
                              # 仍 1.95m→一顆擋死整條路→n_feasible=0→VO 只能停（這就是「靜止人也停」真兇）。
                              # VO 只管動態障礙(真人 r≈0.37)，靜態牆/大物歸 RL LiDAR sweep；故封 0.6 綽綽
                              # 有餘(真人不受影響)，假巨框被砍成 0.6→撞半徑 1.05m→繞得過去。

    # --- 成本權重（越大越貼近 RL 該通道意圖）---
    w_v: 1.0                   # 線速度貼合 RL 意圖的權重
    w_w: 0.15                  # 角速度貼合 RL 意圖的權重。⚠ 0.4→0.15（搭配下方 goal 進展獎勵的關鍵改動）：
                               # 舊版靠 w_w=0.4 重罰轉彎來「正對停」，但這也害「靜止人在前」不敢轉=慢爬卡死。
                               # 改用「進展獎勵」後，「靜止→繞 / 對衝→停」的分流改由 rollout 可行性產生
                               # （移動的人走進側弧→側弧撞→不可行→只剩停；靜止的人側弧不撞→繞），
                               # 不再需要 w_w 重罰轉彎。w_w 降到 0.15 讓 VO 敢 committed 繞行靜止障礙。
                               # 對衝仍停（靠可行性，已模擬驗證）。太高(>0.3)→靜止人在前又退回慢爬不繞。

    # --- goal 進展獎勵（DWA 式，解「靜止人在前→慢爬卡死不繞」）---
    # ⚠ 語意已改：舊版是「終點朝向 vs goal 方位」夾角誤差，會懲罰必要的閃避轉向(轉開=暫時背離 goal)
    #   → 反而卡死。新版 = cost += w_goal·(d_end−d_now)，d_end=弧線終點離 goal 距離：
    #   獎勵「rollout 終點更接近 goal」的弧線 → 靜止障礙在前時主動往側邊繞過去再朝 goal 推進。
    # goal 取自 policy status 的 body-frame goal_dist/goal_ang_deg（配 odom_yaw 反推 odom 座標）。
    # 分流不靠此項：移動逼近的人側弧不可行→停；靜止的人側弧可行→此項讓繞行勝過慢爬。
    # 0=關（遇障只慢/停）；0.6=主動繞（模擬下正中/偏側靜止人都繞、對衝仍停）；太大→障礙旁過度修正抽動。
    w_goal: 0.6

    # --- 啟動距離（障礙進入此範圍才跑 VO）---
    engage_range: 1.0          # 較近才介入（遠處交給 RL）；3.5 稍早反應讓減速更柔（7.0 過早搶 RL 的繞行）

    # --- clearance 退化（解「全候選不可行→急停、不繞」的結構性病根）---
    # 舊行為：horizon 內找不到完全不撞的弧線 → 直接 hard-stop (0,0)。場面一緊就凍結，
    # 20Hz「逐拍往縫隙轉」的繞行可能性被掐死 → 表現成「只停不繞」。
    # True：無可行候選時不急停，改選「碰撞時刻最晚」(=最往空檔挪) 的候選，線速度封到 v_creep
    #       慢爬、保留轉向 → 逐拍重規劃自然擠出繞行。正面對衝的人仍會停（最晚碰撞≈原地），安全不變。
    # ⚠ 首次開啟務必架空車輪 + estop 待命，拿真人走「正對/偏側/站著」三情境驗證再落地。
    clearance_fallback: false   # 暫關：堵死時煞停(0,0)，不做近距滿舵原地猛轉（求穩，繞行靠 progress 項）
    v_creep: 0.3                # m/s — 退化慢爬的線速度上限（安全優先，太大會在堵死時還衝）
    # RL 縮手(rl_v≈0 只原地轉)時 VO 繞行前進地板：實測後退後 RL 不前進、v 鉗位又把 VO 鎖死→原地打轉。
    # 0.3=RL 即使近乎停，VO 也能慢速沿不撞弧繞過去；RL 正常驅動(≥0.3)時不生效→不重現 speedup。
    goaround_v_cap: 0.3

    # --- 卡死逃脫（人走太近→VO堵死停住；若後方有空間，停 N 秒後慢退開空間再繞）---
    # back_m(policy status 後方 LiDAR 淨空)>rear_clear_min 才敢退，防倒退撞牆；退到前方繞行弧
    # 變可行就自動退出、正常繞行接手。後方空間沒了立刻中止。
    stuck_escape_enable: true   # 啟用卡死後退逃脫（false=堵死就停原地不動）
    stuck_timeout_s: 3.0        # blocked+停住連續 3s 才觸發（設長：避免有人只是路過就亂退）
    rear_clear_min_m: 1.2       # 後方淨空(back_m)需 >1.2m 才敢退；退到此值以下(有人擋後方/近牆)立刻中止停車
    escape_reverse_v: -0.2      # 慢退速度 m/s
    escape_max_dist_m: 1.0      # 後退距離上限：退 1m 仍堵死→放棄停車（防前方一直逼→無限後退退穿房間）
