<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vo_interface</name>
  <version>0.1.0</version>
  <description>
    LV-DOT 動態障礙物 → Velocity Obstacle 介面節點。訂閱 onboard_detector 的 dynamic_bboxes，
    自行做 constant-velocity Kalman 追蹤，輸出帶持久 ID / 平滑速度 / 協方差 / track age 的
    TrackedObstacleArray，供下游 VO 規劃器使用。不修改 LV-DOT（純訂閱）。
  </description>
  <maintainer email="gpt0608626@gmail.com">aa</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>

  <!-- python 節點執行期依賴 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
